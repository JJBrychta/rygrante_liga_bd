# ==============================================================================
# rygrante_liga_bd — Linux (Arch) shortcuts
#
# Usage:  make -f MakefileL <target>      (e.g. make -f MakefileL setup)
#
# Standalone: same CI + Docker targets as Makefile (keep them in sync), plus
# Linux setup. Docker Engine on Linux runs containers as other users
# (Spark = UID 185, Airflow = UID 50000), so bind-mounted folders must be
# created and made writable before the first `docker compose up`.
#
# Tip: alias it once in your shell:  alias lmake='make -f MakefileL'
# ==============================================================================

.DEFAULT_GOAL := help
SHELL := /bin/bash

COMPOSE          ?= docker compose
GITLEAKS_VERSION ?= v8.30.1
SEMGREP_IMAGE    ?= semgrep/semgrep:latest
TRIVY_IMAGE      ?= aquasec/trivy:latest

# Local-only paths that CI never sees (secrets, data, build state) — keep them
# out of the Trivy scan so it doesn't flag your own .env credentials.
TRIVY_SKIP_DIRS  := data,lakehouse,logs,.venv,.idea,.ruff_cache,.pytest_cache
TRIVY_SKIP_FILES := .env

.PHONY: help ci ci-fast lint uv-check fix test test-host gitleaks semgrep trivy \
        up down restart ps logs build

help: ## Show this help
	@awk 'BEGIN {FS = ":.*## "; printf "\nUsage: make \033[36m<target>\033[0m\n"} \
		/^##@/ {printf "\n\033[1m%s\033[0m\n", substr($$0, 5)} \
		/^[a-zA-Z_-]+:.*## / {printf "  \033[36m%-12s\033[0m %s\n", $$1, $$2}' $(MAKEFILE_LIST)

##@ CI (mirrors .github/workflows/ci.yml)

ci: lint test gitleaks semgrep trivy ## Run the full CI pipeline locally (all 5 jobs)
	@echo -e "\n\033[32m✔ All CI jobs passed\033[0m"

ci-fast: lint test ## Run only lint + tests (quick pre-push check)
	@echo -e "\n\033[32m✔ lint + tests passed\033[0m"

lint: uv-check ## Job lint-and-uv: uv lock, Ruff lint/format, script + Compose syntax
	uv run ruff check .
	uv run ruff format --check .
	bash -n scripts/download_data.sh
	$(COMPOSE) config --quiet
	@echo -e "\033[32m✔ lint-and-uv passed\033[0m"

uv-check:
	uv lock --check
	uv sync --frozen --dev --quiet

fix: ## Auto-fix Ruff lint issues and reformat code
	uv run ruff check --fix .
	uv run ruff format .

test: ## Job unit-tests: pytest inside the Spark container (no local Java needed)
	$(COMPOSE) run --rm spark-master pytest -v

test-host: ## Job unit-tests exactly like CI (needs Java 17 on your machine)
	uv run pytest -v

gitleaks: ## Job gitleaks: scan committed Git history for secrets
	docker run --rm -v "$(CURDIR):/repo" zricethezav/gitleaks:$(GITLEAKS_VERSION) \
		git --verbose --redact --config /repo/.gitleaks.toml /repo

semgrep: ## Job semgrep: static security analysis (Python, Docker, Compose, secrets)
	docker run --rm -v "$(CURDIR):/src" -w /src $(SEMGREP_IMAGE) \
		semgrep scan --config p/python --config p/dockerfile \
		--config p/docker-compose --config p/secrets --error --metrics=off

trivy: ## Job trivy: CRITICAL/HIGH vulnerability, secret and IaC scans
	docker run --rm -v "$(CURDIR):/src" -v trivy-cache:/root/.cache $(TRIVY_IMAGE) \
		fs --scanners vuln,secret --severity CRITICAL,HIGH --ignore-unfixed --exit-code 1 \
		--skip-dirs $(TRIVY_SKIP_DIRS) --skip-files $(TRIVY_SKIP_FILES) /src
	docker run --rm -v "$(CURDIR):/src" -v trivy-cache:/root/.cache $(TRIVY_IMAGE) \
		config --severity CRITICAL,HIGH --exit-code 1 --skip-dirs $(TRIVY_SKIP_DIRS) /src

##@ Docker stack

up: ## Start the stack (Spark, Airflow, Streamlit) in the background
	$(COMPOSE) up -d

build: ## Rebuild images and start the stack
	$(COMPOSE) up -d --build

down: ## Stop the stack (keeps data and volumes)
	$(COMPOSE) down

restart: down up ## Restart the stack

ps: ## Show container status
	$(COMPOSE) ps -a

logs: ## Follow logs (all services, or one: make logs s=airflow-webserver)
	$(COMPOSE) logs -f --tail 100 $(s)

LINUX_DIRS := data/landing lakehouse/spark-events logs

.PHONY: install setup dirs data first-run doctor java

##@ Arch Linux

install: ## Install system packages with pacman, enable Docker, join docker group (sudo)
	sudo pacman -Syu --needed git docker docker-compose docker-buildx uv
	sudo systemctl enable --now docker
	sudo usermod -aG docker "$$USER"
	@echo -e "\033[33m! Log out and back in so the docker group applies. Reboot if the kernel was upgraded.\033[0m"

setup: dirs ## Create .env (never overwrites), fix folder permissions, install Python 3.11 + deps
	@if [ -f .env ]; then echo ".env exists, keeping it"; else cp .env.example .env && echo -e "\033[33m! Created .env: fill in the R2_* values\033[0m"; fi
	uv python install 3.11
	uv sync --frozen --dev
	@echo -e "\033[32m✔ setup done\033[0m"

dirs: ## Create bind-mount folders writable for the Spark and Airflow containers
	mkdir -p $(LINUX_DIRS)
	chmod 777 data lakehouse lakehouse/spark-events logs dags
	chmod 755 data/landing

data: ## Download + verify the dataset, then make it readable for Spark
	./scripts/download_data.sh
	chmod 755 data/landing
	@echo -e "\033[32m✔ data ready\033[0m"

first-run: setup data build test ## Fresh clone to working stack: setup, data, build, test

java: ## Install Java 17 (only needed for `test-host`)
	sudo pacman -S --needed jdk17-openjdk

doctor: ## Diagnose common Arch problems (service, group, buildx, kernel, folders, .env)
	@ok=1; \
	running=$$(uname -r); \
	if ls /usr/lib/modules/"$$running" >/dev/null 2>&1; then echo "✔ kernel $$running modules present"; \
	else echo "✘ kernel upgraded but not rebooted (running $$running): reboot"; ok=0; fi; \
	if systemctl is-active --quiet docker; then echo "✔ docker service active"; \
	else echo "✘ docker not running: sudo systemctl start docker"; ok=0; fi; \
	if id -nG | grep -qw docker; then echo "✔ user in docker group"; \
	else echo "✘ not in docker group: make -f MakefileL install, then log out/in"; ok=0; fi; \
	if docker buildx version >/dev/null 2>&1; then echo "✔ docker buildx installed"; \
	else echo "✘ buildx missing: sudo pacman -S docker-buildx"; ok=0; fi; \
	if docker compose version >/dev/null 2>&1; then echo "✔ docker compose v2"; \
	else echo "✘ compose missing: sudo pacman -S docker-compose"; ok=0; fi; \
	if command -v uv >/dev/null; then echo "✔ uv installed"; \
	else echo "✘ uv missing: sudo pacman -S uv"; ok=0; fi; \
	for d in data lakehouse logs; do \
		if [ -d "$$d" ] && [ "$$(stat -c %U "$$d")" != root ] && [ -w "$$d" ]; then echo "✔ $$d/ writable"; \
		else echo "✘ $$d/ missing or root-owned: make -f MakefileL dirs (sudo rm -rf $$d first if root-owned)"; ok=0; fi; \
	done; \
	if [ -d data/landing ] && [ "$$(stat -c %a data/landing)" != 700 ]; then echo "✔ data/landing readable by containers"; \
	elif [ -d data/landing ]; then echo "✘ data/landing is 700: chmod 755 data/landing"; ok=0; fi; \
	if [ -f .env ]; then \
		if grep -q '^AIRFLOW_UID=50000' .env; then echo "✔ AIRFLOW_UID=50000"; \
		else echo "✘ AIRFLOW_UID must be 50000 in .env (own UID breaks airflow-init)"; ok=0; fi; \
		empty=$$(grep -cE '^R2_[A-Z_]+=$$' .env); \
		if [ "$$empty" = 0 ]; then echo "✔ R2_* values filled"; else echo "✘ $$empty R2_* values empty in .env"; ok=0; fi; \
	else echo "✘ .env missing: make -f MakefileL setup"; ok=0; fi; \
	if [ $$ok = 1 ]; then echo -e "\033[32m✔ all checks passed\033[0m"; else exit 1; fi
